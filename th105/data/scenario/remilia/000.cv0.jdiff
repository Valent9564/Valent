{
    "14": {
        "lines": [
            "¡No, trae a los sospechosos aquí!"
        ]
    },
    "13": {
        "lines": [
            "Entendido, iré a investigar."
        ]
    },
    "12": {
        "lines": [
            "Sakuya, ya que no puedo moverme —"
        ]
    },
    "11": {
        "lines": [
            "¿En serio?"
        ]
    },
    "10": {
        "lines": [
            "Hmph, debe de haber alguien por ahí intentando obstaculizarme."
        ]
    },
    "9": {
        "lines": [
            "Tal vez no sea solo un verano frío..."
        ]
    },
    "7": {
        "lines": [
            "¡La incertidumbre no es el problema!@",
            "¡Tienes que estar más alerta!"
        ]
    },
    "6": {
        "lines": [
            "¿Será porque de repente llovió afuera?",
            "Porque el clima ha estado bastante inestable últimamente..."
        ]
    },
    "8": {
        "lines": [
            "La señorita Patchouli también parece estar investigando el clima."
        ]
    },
    "5": {
        "lines": [
            "¿No vas a averiguar por qué no puedo salir?"
        ]
    },
    "4": {
        "lines": [
            "¿Hay... un incidente?"
        ]
    },
    "3": {
        "lines": [
            "Entonces, ¿qué vas a hacer con este incidente?"
        ]
    },
    "1": {
        "lines": [
            "Sakuyaaa, ¿estás ahiií?"
        ]
    },
    "2": {
        "lines": [
            "Sí, ¿qué ocurre?"
        ]
    }
}