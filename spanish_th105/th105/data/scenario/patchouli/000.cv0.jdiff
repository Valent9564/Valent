{
    "10": {
        "lines": [
            "Temperamento...@",
            "Quienes usan magia son sensibles a los cambios de temperamento."
        ]
    },
    "9": {
        "lines": [
            "Después de todo eso, ¿de qué se trataba realmente...?"
        ]
    },
    "8": {
        "lines": [
            "Tal como pensé, es más fácil de entender siendo un poco violenta.",
            "Voy a salir un rato."
        ]
    },
    "7": {
        "lines": [
            "¿Eh?",
            "¿Estaba bien que yo ganara?"
        ]
    },
    "6": {
        "lines": [
            "Ahora, intenta moverte un poco."
        ]
    },
    "5": {
        "lines": [
            "¿De qué va todo esto?"
        ]
    },
    "3": {
        "lines": [
            "Quédate quieta un segundo."
        ]
    },
    "2": {
        "lines": [
            "Más o menos."
        ]
    },
    "1": {
        "lines": [
            "Sakuya, ¿estás ahí?"
        ]
    },
    "4": {
        "lines": [
            "Sí, qué enigmático..."
        ]
    }
}