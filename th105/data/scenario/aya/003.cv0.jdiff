{
    "25": {
        "lines": [
            "Hmm, el clima....",
            "¿Tendrá algo que ver con el temperamento?"
        ]
    },
    "24": {
        "lines": [
            "Ah, entendido.",
            "Intentaré que esto sea apto para un artículo."
        ]
    },
    "23": {
        "lines": [
            "Owowowow.",
            "Avísame cuando esto salga en las noticias."
        ]
    },
    "22": {
        "lines": [
            "...¿Así que el clima cambió de repente?"
        ]
    },
    "21": {
        "lines": [
            "Avísame si esto sale en las noticias."
        ]
    },
    "20": {
        "lines": [
            "Pronto será la hora del té."
        ]
    },
    "19": {
        "lines": [
            "¡No se pierdan la próxima edición!"
        ]
    },
    "18": {
        "lines": [
            "¡Ahh! ¿¡Qué es esto?!",
            "¡Nuestra corresponsal no tiene otra opción más que luchar!"
        ]
    },
    "17": {
        "lines": [
            "¡Si no corres te van a comer vivooo!"
        ]
    },
    "16": {
        "lines": [
            "Bueno, ya que estoy tan aburrida, ¡juguemos un poco con el Mokele!"
        ]
    },
    "15": {
        "lines": [
            "¿Hmmmmmm?"
        ]
    },
    "14": {
        "lines": [
            "Sí, eso es lo que dije.",
            "Desde hace poco que todo está raro."
        ]
    },
    "13": {
        "lines": [
            "...",
            "¿Dijiste que el clima cambió de repente?"
        ]
    },
    "12": {
        "lines": [
            "Después de todo, soy débil contra la lluvia."
        ]
    },
    "11": {
        "lines": [
            "De repente empezó a llover afuera, así que no puedo salir."
        ]
    },
    "10": {
        "lines": [
            "¿Oh?",
            "¿El clima, dices?"
        ]
    },
    "9": {
        "lines": [
            "Porque estoy aburrida...",
            "y el clima afuera no es muy bueno...."
        ]
    },
    "8": {
        "lines": [
            "Hoy sí que te estás dejando llevar por la corriente, ¿eh?"
        ]
    },
    "7": {
        "lines": [
            "¿Mo, Moke?",
            "Lo siento, no puedo actuar algo así."
        ]
    },
    "6": {
        "lines": [
            "Un monstruo carnívoro tan temible.",
            "¿¡Podría ser el legendario Mokele-mbembe?!"
        ]
    },
    "5": {
        "lines": [
            "¡Te-voy-a-comerrr-!"
        ]
    },
    "4": {
        "lines": [
            "¡E-está aquí! ¡Es un monstruo!",
            "¿¡Qué le pasará a nuestra corresponsal?!"
        ]
    },
    "3": {
        "lines": [
            "¡Grrr-!"
        ]
    },
    "2": {
        "lines": [
            "Me pregunto qué bestias diabólicas se esconderán en esta mansión."
        ]
    },
    "1": {
        "lines": [
            "¡Nos hemos infiltrado la Mansión del Demonio Escarlata!"
        ]
    }
}