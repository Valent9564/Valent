{
    "12": {
        "lines": [
            "Oye, Sakuya,",
            "¡eso no tiene sentido! ¡Trae al siguiente!"
        ]
    },
    "11": {
        "lines": [
            "¿Qué?"
        ]
    },
    "10": {
        "lines": [
            "Para hacer que llueva, tú...",
            "controlas muñecas..."
        ]
    },
    "9": {
        "lines": [
            "No me importa lo que estés haciendo, ¿pero podrías no estorbarme?"
        ]
    },
    "7": {
        "lines": [
            "Me pregunto por qué estás tan ocupada.",
            "Debe ser porque haces cosas malas."
        ]
    },
    "6": {
        "lines": [
            "No tengo tiempo para jugar contigo."
        ]
    },
    "5": {
        "lines": [
            "Todos los criminales dicen eso."
        ]
    },
    "8": {
        "lines": [
            "Estoy ocupada investigando el terremoto."
        ]
    },
    "4": {
        "lines": [
            "¡¿De qué estás hablando?!",
            "Ya lo sabes, ¿no?"
        ]
    },
    "1": {
        "lines": [
            "Sakuya ya debería haber atrapado al primer sospechoso, ¿no?"
        ]
    },
    "3": {
        "lines": [
            "E-ejem...",
            "Eres Alice, ¿verdad?"
        ]
    },
    "2": {
        "lines": [
            "¡Oye, oye, pero qué...!"
        ]
    }
}