{
    "15": {
        "lines": [
            "¡Sería raro si pudiera!"
        ]
    },
    "14": {
        "lines": [
            "Qué raro.",
            "¿No puedes mantener la calma incluso con esta nieve cayendo alrededor?"
        ]
    },
    "13": {
        "lines": [
            "¿Eh? ¿Es verano?"
        ]
    },
    "12": {
        "lines": [
            "Ahora está más fresco, ¿verdad?"
        ]
    },
    "11": {
        "lines": [
            "¿Qué demonios está pasando?"
        ]
    },
    "10": {
        "lines": [
            "¿¡Quéééé, qué fecha es hoy!?"
        ]
    },
    "9": {
        "lines": [
            "Ya bastaー ",
            "¡Me estás confundiendo, no entiendo nada!"
        ]
    },
    "8": {
        "lines": [
            "Entonces vamos a poseerte."
        ]
    },
    "7": {
        "lines": [
            "No estoy poseída."
        ]
    },
    "6": {
        "lines": [
            "Oh cielos, te ves como si estuvieras poseída."
        ]
    },
    "5": {
        "lines": [
            "Nunca pensé que no me despertaría hasta el invierno.."
        ]
    },
    "4": {
        "lines": [
            "Oh nooo... ",
            "Pensé que solo me había quedado dormida, pero..."
        ]
    },
    "3": {
        "lines": [
            "Buenos días."
        ]
    },
    "2": {
        "lines": [
            "...¿¡Qué, está nevando!?"
        ]
    },
    "1": {
        "lines": [
            "¿Por qué demonios hace tanto frío hoy...?"
        ]
    }
}