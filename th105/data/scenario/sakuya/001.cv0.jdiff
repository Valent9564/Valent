{
    "23": {
        "lines": [
            "No, siento que algo extremadamente extraño está ocurriendo..."
        ]
    },
    "22": {
        "lines": [
            "Si quieres venir a mi casa, siéntete como en la tuya."
        ]
    },
    "21": {
        "lines": [
            "No está ocurriendo nada extraño a mi alrededor."
        ]
    },
    "19": {
        "lines": [
            "... ¿eh?"
        ]
    },
    "20": {
        "lines": [
            "¿Nieve?",
            "Pero si ahora es verano...."
        ]
    },
    "18": {
        "lines": [
            "¡Wahh, señorita Yuyuko!"
        ]
    },
    "17": {
        "lines": [
            "¿Qué es lo extraño, Youmu?"
        ]
    },
    "15": {
        "lines": [
            "Pero algo extraño está ocurriendo en la mansión."
        ]
    },
    "16": {
        "lines": [
            "¿Algo extraño...?@",
            "Eso hace que quiera ir allí aún más."
        ]
    },
    "14": {
        "lines": [
            "Supongo que no puedo detenerte."
        ]
    },
    "13": {
        "lines": [
            "Entonces me dirigiré a tu mansión."
        ]
    },
    "12": {
        "lines": [
            "Pero han estado ocurriendo cosas extrañas en la mansión."
        ]
    },
    "11": {
        "lines": [
            "Últimamente no ha habido enemigos de sangre caliente por aquí."
        ]
    },
    "10": {
        "lines": [
            "No sé qué está pasando, pero no pienso dejarte pasar."
        ]
    },
    "8": {
        "lines": [
            "¿Fantasma?",
            "Si es eso, creo que ya salió."
        ]
    },
    "9": {
        "lines": [
            "Qué extraño, qué extraño.",
            "Déjame pasar, ¿quieres?"
        ]
    },
    "7": {
        "lines": [
            "Algo fantasmal está saliendo de tu cuerpo."
        ]
    },
    "6": {
        "lines": [
            "¿Eh?",
            "¿De qué estás hablando?"
        ]
    },
    "5": {
        "lines": [
            "También está saliendo de tu cuerpo."
        ]
    },
    "3": {
        "lines": [
            "¿Qué está pasando?",
            "Esa cara tan feroz."
        ]
    },
    "2": {
        "lines": [
            "Ki del cuerpo... suena a fantasmas."
        ]
    },
    "1": {
        "lines": [
            "Este ki parece estar siendo absorbido de los cuerpos."
        ]
    },
    "4": {
        "lines": [
            "No, es otro fenómeno inusual...."
        ]
    }
}