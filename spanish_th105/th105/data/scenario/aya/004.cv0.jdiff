{
    "14": {
        "lines": [
            "¡Chao!",
            "¡Tengo prisa!"
        ]
    },
    "13": {
        "lines": [
            "¿Vas a estorbarme?",
            "¡No voy a contenerme contigo!"
        ]
    },
    "12": {
        "lines": [
            "Pero antes tendré que echar",
            "a quienes entran a la montaña sin permiso."
        ]
    },
    "11": {
        "lines": [
            "Bueno, entonces iré para allá a tomar notas.",
            "Quién iba a pensar que el santuario sería destruido...."
        ]
    },
    "10": {
        "lines": [
            "¡Escribe lo que quieras!",
            "¡Voy a encontrar a alguien que pueda reparar mi santuario!"
        ]
    },
    "9": {
        "lines": [
            "¿Eh?",
            "¿Eso da para buen material?"
        ]
    },
    "8": {
        "lines": [
            "¡Mi santuario fue demolido!",
            "¡Por un terremoto!"
        ]
    },
    "7": {
        "lines": [
            "Espera, espera.",
            "¿Qué pasó?"
        ]
    },
    "6": {
        "lines": [
            "El viento y la lluvia van bien con alguien como tú.",
            "¡Solo estoy de paso, así que piérdete!"
        ]
    },
    "5": {
        "lines": [
            "¿Acaso quieres morir?"
        ]
    },
    "4": {
        "lines": [
            "Oye, oye, venir a la montaña con un viento así..."
        ]
    },
    "3": {
        "lines": [
            "Uwaa, otra vez este clima tan horrible."
        ]
    },
    "2": {
        "lines": [
            "No puedo escribir nada interesante con esto....",
            "¿Oh?"
        ]
    },
    "1": {
        "lines": [
            "Últimamente no encuentro ningún buen material."
        ]
    }
}