{
    "21": {
        "lines": [
            "Estás aquí, ¿no?",
            "Sal de una vez."
        ]
    },
    "20": {
        "lines": [
            "... ¿Eh?"
        ]
    },
    "19": {
        "lines": [
            "No tiene sentido pelear contigo.",
            "Mi objetivo es derrotar a quien está reuniendo la niebla de temperamento."
        ]
    },
    "18": {
        "lines": [
            "¿No estaría bien que todos empezaran a moverse?"
        ]
    },
    "17": {
        "lines": [
            "Llegaste demasiado pronto."
        ]
    },
    "16": {
        "lines": [
            "Pero si quisiera, digamos, destruir el santuario,",
            "no habría forma de que llegara tarde, ¿no?"
        ]
    },
    "15": {
        "lines": [
            "Si vas a intentar hacer algo, llegaste demasiado tarde."
        ]
    },
    "14": {
        "lines": [
            "Jajaja",
            "¿No es un poco pronto para eso?"
        ]
    },
    "13": {
        "lines": [
            "Tu temperamento mentiroso se está filtrando por todo tu cuerpo."
        ]
    },
    "12": {
        "lines": [
            "Jajaja",
            "No he visto a alguien así en absoluto."
        ]
    },
    "11": {
        "lines": [
            "Según mi intuición, debería estar por aquí."
        ]
    },
    "10": {
        "lines": [
            "Hmm-"
        ]
    },
    "9": {
        "lines": [
            "He venido buscando a quien está reuniendo la niebla",
            "de temperamento y alterando el clima."
        ]
    },
    "8": {
        "lines": [
            "¿Para qué has venido hasta los cielos?"
        ]
    },
    "7": {
        "lines": [
            "Vaya, me siento honrada."
        ]
    },
    "6": {
        "lines": [
            "Y después de eso, te esperan más cantos y danzas."
        ]
    },
    "5": {
        "lines": [
            "En el Cielo hay cantos y danzas..."
        ]
    },
    "4": {
        "lines": [
            "Bienvenida a los lejanos cielos."
        ]
    },
    "3": {
        "lines": [
            "probablemente no se verían afectados por el desastre de aquí."
        ]
    },
    "2": {
        "lines": [
            "Si hay alguien transformando indiscriminadamente",
            "la niebla de temperamento,"
        ]
    },
    "1": {
        "lines": [
            "¿Había un mundo así más allá de las nubes...?"
        ]
    }
}