{
    "15": {
        "lines": [
            "Parece que tendré que abandonar esa idea."
        ]
    },
    "14": {
        "lines": [
            "No, perdí..."
        ]
    },
    "13": {
        "lines": [
            "Mi efímera nieve no puede vencer tu tempestad."
        ]
    },
    "12": {
        "lines": [
            "¿Supongo?"
        ]
    },
    "11": {
        "lines": [
            "Lamentablemente, mi poder no fue suficiente."
        ]
    },
    "10": {
        "lines": [
            "Si alguien como tú se encuentra con cierta persona aquí arriba,",
            "podría ocurrir algo muy malo."
        ]
    },
    "9": {
        "lines": [
            "Ahora, márchate."
        ]
    },
    "8": {
        "lines": [
            "Sí, mi nieve embellecedora de montañas."
        ]
    },
    "7": {
        "lines": [
            "¿Nieve?"
        ]
    },
    "6": {
        "lines": [
            "Vaya... parece que la nieve salió volando."
        ]
    },
    "5": {
        "lines": [
            "Nadie tiene permitido entrar en la montaña."
        ]
    },
    "4": {
        "lines": [
            "La verdad es que no entiendo muy bien qué está pasando, pero..."
        ]
    },
    "3": {
        "lines": [
            "Ayaya,",
            "la nieve..."
        ]
    },
    "1": {
        "lines": [
            "Llenemos este lugar de nieve también."
        ]
    },
    "2": {
        "lines": [
            "¿Eh?",
            "¿Por qué estás aquí?"
        ]
    }
}