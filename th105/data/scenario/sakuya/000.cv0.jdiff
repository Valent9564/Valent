{
    "17": {
        "lines": [
            "Dejó de llover, ",
            "así que saldré un rato."
        ]
    },
    "16": {
        "lines": [
            "¿No fuiste tú quien me atacó primero?"
        ]
    },
    "15": {
        "lines": [
            "Entonces no pelees."
        ]
    },
    "14": {
        "lines": [
            "Tú tampoco me sirves para nada."
        ]
    },
    "13": {
        "lines": [
            "Hoy también iré a tomar prestados algunos libros de la biblioteca."
        ]
    },
    "11": {
        "lines": [
            "Mira, tu cuerpo también está emitiendo...."
        ]
    },
    "12": {
        "lines": [
            "De todos modos, ¡no me sirves para nada!"
        ]
    },
    "10": {
        "lines": [
            "¿Ahh?",
            "Nada en absoluto."
        ]
    },
    "9": {
        "lines": [
            "Bueno, es cierto que el clima ha estado malo últimamente.",
            "Aparte de eso, ¿qué más sientes?"
        ]
    },
    "8": {
        "lines": [
            "¡No los tomes sin permiso!"
        ]
    },
    "7": {
        "lines": [
            "Así es, es problemático porque no deja de llover.@",
            "Hace que los libros que llevo a casa se mojen."
        ]
    },
    "6": {
        "lines": [
            "Vaya, está lloviendo."
        ]
    },
    "4": {
        "lines": [
            "No creo que esté lloviendo por aquí."
        ]
    },
    "3": {
        "lines": [
            "Oye, ¿qué pasa?",
            "¿Viniste a recolectar agua de lluvia para cocinar?"
        ]
    },
    "2": {
        "lines": [
            "Parece que algo está saliendo de mi cuerpo."
        ]
    },
    "5": {
        "lines": [
            "¿Hm?",
            "Si quieres lluvia, ¿acaso no está lloviendo?"
        ]
    },
    "1": {
        "lines": [
            "¿Qué es esto...."
        ]
    }
}