{
    "12": {
        "lines": [
            "Si tu cabeza se enfría, quizá puedas pasar tranquilamente",
            "un verano agradable."
        ]
    },
    "11": {
        "lines": [
            "Qué bueno."
        ]
    },
    "10": {
        "lines": [
            "¡Pero si hace frío!"
        ]
    },
    "9": {
        "lines": [
            "¿Ya te refrescaste?"
        ]
    },
    "8": {
        "lines": [
            "No puedo entender nada, pero me da miedo..."
        ]
    },
    "7": {
        "lines": [
            "¿Cómo hiciste que nevara aquí?"
        ]
    },
    "6": {
        "lines": [
            "¡¡Estás planeando algo peligroso!!"
        ]
    },
    "5": {
        "lines": [
            "Y así, despídete del caluroso y soleado mundo del verano."
        ]
    },
    "4": {
        "lines": [
            "¿¡Eh?",
            "¡Espera, espera!"
        ]
    },
    "3": {
        "lines": [
            "Bueno, me pregunto si seguirás pudiendo decir eso",
            "después de ver esto."
        ]
    },
    "2": {
        "lines": [
            "Ahh, hoy hace muchísimo calor. ",
            "Me pregunto si será así para todos."
        ]
    },
    "1": {
        "lines": [
            "Ahora, este verano sofocantemente caluroso terminará prontoー"
        ]
    }
}