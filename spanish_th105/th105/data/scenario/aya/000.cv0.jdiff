{
    "13": {
        "lines": [
            "Eso no es posible.",
            "El clima no es algo que pueda predecirse."
        ]
    },
    "12": {
        "lines": [
            "Entonces, este mal clima...",
            "¿es obra tuya?"
        ]
    },
    "11": {
        "lines": [
            "Ah, esto no es bueno.",
            "Si intervengo y peleo, ya no sería objetivo"
        ]
    },
    "10": {
        "lines": [
            "No había visto vientos tan fuertes en mucho tiempo."
        ]
    },
    "9": {
        "lines": [
            "El clima está horrible."
        ]
    },
    "8": {
        "lines": [
            "¡Ah! ¡La sacerdotisa está escapando!"
        ]
    },
    "7": {
        "lines": [
            "Hasta hace un momento no había ni una nube cerca....",
            "Será mejor recoger la ropa."
        ]
    },
    "6": {
        "lines": [
            "...¿eh?",
            "El clima se volvió malo de repente."
        ]
    },
    "5": {
        "lines": [
            "Ya estás otra vez con lo mismo...."
        ]
    },
    "4": {
        "lines": [
            "Está bien.",
            "Por favor, no me hagas caso y continúa con normalidad."
        ]
    },
    "3": {
        "lines": [
            "¡No!"
        ]
    },
    "2": {
        "lines": [
            "Hoy vamos a estudiar el comportamiento de una sacerdotisa."
        ]
    },
    "1": {
        "lines": [
            "Les habla su simpática reportera local, Shameimaru."
        ]
    }
}