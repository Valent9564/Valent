{
    "18": {
        "lines": [
            "Ah, está bien.",
            "Cuento contigo."
        ]
    },
    "17": {
        "lines": [
            "Entonces te ayudaré a investigar en al respecto."
        ]
    },
    "16": {
        "lines": [
            "¿Eh? ¿Eh?",
            "¿De qué estás hablando?"
        ]
    },
    "15": {
        "lines": [
            "Eso debería ser trabajo de la señorita Yuyuko."
        ]
    },
    "14": {
        "lines": [
            "¿Eh? ¿Nieve?"
        ]
    },
    "13": {
        "lines": [
            "¿El clima...?",
            "Ah, ¿te refieres a hacer que nieve cerca de la mansión?"
        ]
    },
    "12": {
        "lines": [
            "Haciendo que el clima sea extraño."
        ]
    },
    "11": {
        "lines": [
            "¿Haciendo esto...?"
        ]
    },
    "9": {
        "lines": [
            "Los fantasmas han estado disminuyendo últimamente,",
            "así que quizá puedas investigar eso."
        ]
    },
    "7": {
        "lines": [
            "Entonces está decidido.",
            "¡Esta vez tú eres la criminal!"
        ]
    },
    "10": {
        "lines": [
            "¿Qué ganas haciendo esto?"
        ]
    },
    "8": {
        "lines": [
            "Estás aburrida, ¿no?"
        ]
    },
    "6": {
        "lines": [
            "¿El clima?@",
            "No, eso fue cosa de la señorita Yuyuko..."
        ]
    },
    "3": {
        "lines": [
            "Deberías tener más cuidado al escuchar palabras dulces."
        ]
    },
    "4": {
        "lines": [
            "Me arrastraron aquí a la fuerza.
        ]
    },
    "2": {
        "lines": [
            "¿Eh? Sakuya dijo que había una fiesta aquí",
            "y me arrastró a la fuerza..."
        ]
    },
    "5": {
        "lines": [
            "Ah, deja de susurrar.@",
            "¿No manipulaste el clima antes?"
        ]
    },
    "1": {
        "lines": [
            "¡Sí, adelante!"
        ]
    }
}