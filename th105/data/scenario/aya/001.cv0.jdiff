{
    "15": {
        "lines": [
            "Solo dormir no es interesante en absoluto..."
        ]
    },
    "14": {
        "lines": [
            "¡Me voy a quedar en casa durmiendo!"
        ]
    },
    "13": {
        "lines": [
            "No tengo ganas de hacer nada con este clima."
        ]
    },
    "12": {
        "lines": [
            "Está bien, por favor continúa."
        ]
    },
    "11": {
        "lines": [
            "No tengo corazón para salir con un clima tan malo."
        ]
    },
    "10": {
        "lines": [
            "Voy a volver a la casa."
        ]
    },
    "9": {
        "lines": [
            "Como sea. ",
            "Te voy a mandar de vuelta."
        ]
    },
    "8": {
        "lines": [
            "¿No?",
            "¿El clima por aquí no siempre fue así?"
        ]
    },
    "7": {
        "lines": [
            "Oye, el viento está soplando....",
            "¿Qué pasa con este viento?, ¿tú eres la responsable de esto?"
        ]
    },
    "6": {
        "lines": [
            "...No, mejor te espanto primero y luego me regreso."
        ]
    },
    "5": {
        "lines": [
            "Adelante, adelante."
        ]
    },
    "4": {
        "lines": [
            "Entonces me voy regresando."
        ]
    },
    "3": {
        "lines": [
            "¿Qué?, ¿eres tú?"
        ]
    },
    "2": {
        "lines": [
            "Hoy vamos a estudiar el comportamiento de una ladrona."
        ]
    },
    "1": {
        "lines": [
            "Les habla su simpática reportera local, Shameimaru."
        ]
    }
}