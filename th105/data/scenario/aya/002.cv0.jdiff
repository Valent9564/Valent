{
    "15": {
        "lines": [
            "¿Qué pasa con este clima de todos modos...?",
            "Nah, debe ser coincidencia."
        ]
    },
    "14": {
        "lines": [
            "Vaya, qué insistente eres."
        ]
    },
    "13": {
        "lines": [
            "Entonces, con permiso."
        ]
    },
    "12": {
        "lines": [
            "¿Se acerca un tifón?"
        ]
    },
    "11": {
        "lines": [
            "¿Qué pasa con este clima?"
        ]
    },
    "10": {
        "lines": [
            "Rechazado."
        ]
    },
    "9": {
        "lines": [
            "No, eso simplemente no es posible.",
            "¡La operación de infiltración comienza ahora!"
        ]
    },
    "8": {
        "lines": [
            "¿No eres tú quien trajo esta tormenta?"
        ]
    },
    "7": {
        "lines": [
            "Ah, vuelve a estar tormentoso..."
        ]
    },
    "6": {
        "lines": [
            "...El clima empeoró.",
            "Esto no pinta bien."
        ]
    },
    "4": {
        "lines": [
            "¡Es el primer obstáculo!"
        ]
    },
    "5": {
        "lines": [
            "Vaya, cuando hay paz, estos tipos salen en masa."
        ]
    },
    "3": {
        "lines": [
            "Rechazado."
        ]
    },
    "2": {
        "lines": [
            "Hoy vamos a infiltrarnos en la Mansión del Demonio Escarlata",
            "para traerles la primicia más reciente."
        ]
    },
    "1": {
        "lines": [
            "Les habla su simpática reportera local, Shameimaru."
        ]
    }
}