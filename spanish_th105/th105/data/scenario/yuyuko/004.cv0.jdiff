{
    "22": {
        "lines": [
            "Oh, lo siento, pero no puedo.",
            "Todavía tengo muchos apegos a este mundo."
        ]
    },
    "21": {
        "lines": [
            "Eres realmente fuerte.",
            "No creo que tengas problemas para alcanzar el nirvana."
        ]
    },
    "20": {
        "lines": [
            "Y ahora, el siguiente destino: el Cielo."
        ]
    },
    "19": {
        "lines": [
            "Si no puedes alcanzar el estado de la no percepción,",
            "no podrás convertirte en una celestial."
        ]
    },
    "18": {
        "lines": [
            "Aún no estás lista."
        ]
    },
    "17": {
        "lines": [
            "Pero hay muchas pruebas antes de alcanzar el nirvana.",
            "¿Podrás superarlas?"
        ]
    },
    "16": {
        "lines": [
            "Ah, sobre estas nubes está el Reino Celestial.",
            "¿Supongo que has venido por tu cuenta para alcanzar el nirvana?"
        ]
    },
    "15": {
        "lines": [
            "¿Un fantasma?"
        ]
    },
    "14": {
        "lines": [
            "Solo soy un humilde fantasma",
            "que trae un poco de frescura a todos."
        ]
    },
    "13": {
        "lines": [
            "De todos modos, ¿Quién eres?"
        ]
    },
    "12": {
        "lines": [
            "Vaya, supongo que no se puede evitar.",
            "Quizá sea hora de reforzar la casa."
        ]
    },
    "11": {
        "lines": [
            "No estoy segura, pero ahora mismo lo estamos investigando."
        ]
    },
    "10": {
        "lines": [
            "¿Qué?",
            "¿Va a ocurrir un terremoto?"
        ]
    },
    "9": {
        "lines": [
            "Por supuesto que no."
        ]
    },
    "8": {
        "lines": [
            "...a la parrilla con salsa de soja, o simplemente a la parrilla..."
        ]
    },
    "7": {
        "lines": [
            "Sí, soy la mensajera del Palacio del Dragón."
        ]
    },
    "6": {
        "lines": [
            "Oh, ¿acaso tú eres...?"
        ]
    },
    "5": {
        "lines": [
            "El regreso del desastre tras varias décadas se acerca."
        ]
    },
    "3": {
        "lines": [
            "Las nubes escarlatas están formándose de nuevo."
        ]
    },
    "4": {
        "lines": [
            "Observa atentamente el movimiento de las nubes."
        ]
    },
    "1": {
        "lines": [
            "Como era de esperar, hace frío dentro de las nubes."
        ]
    },
    "2": {
        "lines": [
            "No hay ni un solo sitio despejado..."
        ]
    }
}