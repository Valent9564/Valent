{
    "14": {
        "lines": [
            "¡Sakuyaaa!",
            "¡El siguiente!"
        ]
    },
    "13": {
        "lines": [
            "Sí, sí.",
            "Estoy algo ocupada, así que me retiro."
        ]
    },
    "12": {
        "lines": [
            "¿Tú... hiciste que el clima sea extraño...",
            "para poder observar la luna?"
        ]
    },
    "11": {
        "lines": [
            "Iré a buscar a youkai que hayan vivido aún más tiempo."
        ]
    },
    "10": {
        "lines": [
            "Fue un error confiar tanto en ti."
        ]
    },
    "8": {
        "lines": [
            "Es una emergencia, así que vine aquí",
            "pensando que podrías tener alguna pista."
        ]
    },
    "7": {
        "lines": [
            "¿Por qué hiciste algo así?"
        ]
    },
    "9": {
        "lines": [
            "¿Crees que puedes engañarme con eso?"
        ]
    },
    "6": {
        "lines": [
            "¿Por qué estás perdiendo el tiempo?",
            "¡Esto es una emergencia!"
        ]
    },
    "4": {
        "lines": [
            "¿Ah?"
        ]
    },
    "3": {
        "lines": [
            "Ah, ejem.",
            "Tienes los papeles invertidos, amiga."
        ]
    },
    "5": {
        "lines": [
            "Yo soy quien hace las preguntas.@",
            "Responde solo a las preguntas que te estoy haciendo."
        ]
    },
    "2": {
        "lines": [
            "Tengo algo que preguntar. ¿Está bien?"
        ]
    },
    "1": {
        "lines": [
            "Me pregunto quién sigue..."
        ]
    }
}